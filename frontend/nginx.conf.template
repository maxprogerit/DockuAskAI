# Rendered by the official nginx image at start-up: ${API_KEY} is substituted from the container
# environment (only variables that are set are replaced, nginx's own $uri etc. are left alone).
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Slightly above the API's MAX_UPLOAD_MB (default 20) so the API, not nginx, answers
    # oversized uploads with its JSON error. Raise both together.
    client_max_body_size 25m;

    # Upload (parse + embed) and /ask (retrieval + LLM + one possible retry) are synchronous.
    proxy_read_timeout 180s;
    proxy_send_timeout 180s;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    # The PDF source viewer embeds /api/documents/<id>/file in an <iframe> of this same origin.
    add_header X-Frame-Options SAMEORIGIN always;

    # Backend. The browser never sees the API key: it is added here, server side.
    # A client-supplied X-API-Key is overwritten, not forwarded.
    location /api/ {
        proxy_pass http://api:8000/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-API-Key "${API_KEY}";
    }

    # Hashed build assets can be cached forever; index.html must always be revalidated.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options nosniff always;
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options SAMEORIGIN always;
        try_files $uri /index.html;
    }
}
