# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# --- API ---
# Clients send this in the X-API-Key header. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
LOG_LEVEL=INFO
# Host port for the API container (docker compose). Change it if 8000 is taken on your machine.
API_HOST_PORT=8000

# --- PostgreSQL (docker-compose reads the POSTGRES_* values for the container) ---
POSTGRES_USER=docuask
POSTGRES_PASSWORD=docuask
POSTGRES_DB=docuask
# 55432 avoids clashing with other local Postgres instances (5432/5433).
POSTGRES_HOST_PORT=55432
# Used when running the API on the host (uvicorn). Inside docker-compose the host is `postgres`
# and compose overrides this value itself.
DATABASE_URL=postgresql+psycopg://docuask:docuask@localhost:55432/docuask

# --- Storage (host runs only; compose mounts volumes at /data/...) ---
UPLOAD_DIR=./data/uploads
CHROMA_DIR=./data/chroma

# --- Upload limits ---
MAX_UPLOAD_MB=20
MAX_PAGES=300

# --- OpenAI ---
OPENAI_API_KEY=
# Defaults shown; uncomment to override. Prices/limits: see README "Model choice".
# OPENAI_MODEL=gpt-6-luna
# OPENAI_REASONING_EFFORT=low
# EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_TIMEOUT_S=30
# OPENAI_MAX_RETRIES=3
# Evaluation only: the model that grades answers (a different, stronger model than the generator).
# EVAL_JUDGE_MODEL=gpt-6.1-sol

# --- Retrieval / chunking (units: chunk size and overlap in CHARACTERS) ---
# These defaults are PLACEHOLDERS until `python -m eval.run auto` has been run with a real key;
# the evaluation writes the values it recommends to eval/reports/final_defaults_*.env.
# CHUNK_SIZE=500
# CHUNK_OVERLAP=100
# TOP_K=5
# SCORE_THRESHOLD=0.30

# --- Web UI (docker compose "web" service: React + nginx) ---
# Bound to loopback by default because nginx injects the API key for every request.
# WEB_HOST_PORT=8080
# WEB_BIND=127.0.0.1
